# API Configuration
API_BASE_URL=https://api.example.com/stocks
API_BEARER_TOKEN=your_bearer_token_here

# CockroachDB Configuration
# Format: postgresql://username:password@host:port/database?sslmode=verify-full
# Example for CockroachDB Cloud:
DATABASE_URL=postgresql://username:password@your-cluster.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# Example for local CockroachDB:
# DATABASE_URL=postgresql://root@localhost:26257/stockdb?sslmode=disable
